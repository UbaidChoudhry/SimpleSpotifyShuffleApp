# Copy this file to .env and fill in the value. .env is gitignored.
# Get the Client ID from https://developer.spotify.com/dashboard
# In that app's settings, add both redirect URIs:
#   pureshuffle://callback
#   pureshuffle://spotify-app-remote-callback
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Ceiling on outbound Spotify Web API requests per second. Optional —
# defaults to 20 if unset. Lower it if you start hitting 429s.
EXPO_PUBLIC_SPOTIFY_MAX_TPS=20

# After a 429, stop sending Spotify requests entirely for this many seconds.
# Optional — defaults to 30. Spotify's quota is a rolling window, so continuing
# to probe after the first rejection is what turns a short throttle into a
# multi-hour lockout.
EXPO_PUBLIC_SPOTIFY_RATE_LIMIT_COOLDOWN_SEC=30
